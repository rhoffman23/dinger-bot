# ============================================================================
# Dinger Bot Configuration File
# ============================================================================
# This is an EXAMPLE file showing all required configuration variables.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to a new file named: config-dev.js
# 2. Fill in all values with your actual credentials
# 3. NEVER commit config-dev.js to version control
# 4. NEVER share these credentials publicly
#
# Note: This is a .env.example file for reference. 
# The actual config is loaded from config-dev.js as a JavaScript module.
# ============================================================================

# ============================================================================
# Discord Bot Configuration
# ============================================================================
# Get your Discord bot token from:
# 1. Go to https://discord.com/developers/applications
# 2. Create a new application
# 3. Go to "Bot" tab
# 4. Click "Add Bot"
# 5. Copy the token under "TOKEN"
#
# Permissions needed:
# - Send Messages
# - Read Messages/View Channels
# - Read Message History

DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ============================================================================
# Twitter API Configuration
# ============================================================================
# Get your Twitter API v2 Bearer Token from:
# 1. Go to https://developer.twitter.com/en/portal/dashboard
# 2. Create or select your app
# 3. Go to "Keys and tokens" tab
# 4. Copy the "Bearer Token"
#
# Required API Access:
# - Twitter API v2
# - Read access to Tweet Stream

TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ============================================================================
# Google Sheets Configuration
# ============================================================================
# The SPREADSHEET_ID is found in the URL of your Google Sheet:
# https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
#
# SPREADSHEET_LINK should be the shareable link to your sheet:
# https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]

SPREADSHEET_ID=your_google_sheet_id_here
SPREADSHEET_LINK=https://docs.google.com/spreadsheets/d/your_google_sheet_id_here

# ============================================================================
# Google Service Account Credentials
# ============================================================================
# Create a Google Service Account:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing one
# 3. Go to "Service Accounts" page
# 4. Create a new service account
# 5. Create a new JSON key
# 6. Download the JSON file
# 7. Copy the entire JSON content below
#
# Then share your Google Sheet with the service account email:
# - Look for "client_email" in the JSON
# - Share the sheet with that email address
# - Give it Editor permissions

GOOGLE_SERVICE_ACCOUNT_JSON={
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your-private-key-id",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "your-service-account@your-project.iam.gserviceaccount.com",
  "client_id": "your-client-id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs"
}

# ============================================================================
# Discord Server Setup
# ============================================================================
# OPTIONAL: You can specify specific channel and role IDs if needed
# 
# To get a Channel ID:
# 1. Enable Developer Mode in Discord (User Settings → Developer Mode)
# 2. Right-click the channel
# 3. Click "Copy Channel ID"

# HOME_RUN_CHANNEL_ID=your_channel_id_here
# MODERATOR_ROLE_ID=your_role_id_here

# ============================================================================
# Application Settings (Optional)
# ============================================================================
# These settings can be modified to customize bot behavior

# Twitter stream check interval (milliseconds)
STREAM_CHECK_INTERVAL=2000

# Maximum retry attempts before giving up
# (The actual retry uses exponential backoff)
MAX_RETRY_ATTEMPTS=10

# Node environment (development or production)
NODE_ENV=development

# ============================================================================
# IMPORTANT REMINDERS
# ============================================================================
#
# 1. NEVER commit config-dev.js to git
#    Add this to .gitignore: config-dev.js
#
# 2. NEVER share your tokens publicly
#    - Don't paste them in Discord
#    - Don't email them
#    - Don't publish them on GitHub
#
# 3. ROTATE TOKENS REGULARLY
#    If you suspect a token has been compromised, 
#    regenerate it immediately from the respective platform
#
# 4. USE ENVIRONMENT VARIABLES IN PRODUCTION
#    For production, use environment variables instead of 
#    hardcoding credentials in config files
#
# 5. VERIFY PERMISSIONS
#    Make sure all services have minimum required permissions:
#    - Discord Bot: Message permissions only
#    - Google Service Account: Edit access only to specific sheets
#    - Twitter API: Read-only access
#
# ============================================================================
